# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# Admin access is managed via Supabase app_metadata — no env var needed.
# In the Supabase dashboard → Authentication → Users → select a user
# → Edit → set app_metadata to: {"role": "admin"}
# Any user with that metadata is granted admin access.
